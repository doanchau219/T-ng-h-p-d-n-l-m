    {
      "name": "Kiểm tra 2 giống mèo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Kiểm tra xem response có mã HTTP 200 OK không",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              " ",
              "const breeds = pm.response.json();",
              "pm.test(\"Breeds array is not empty\", function () {",
              "    pm.expect(breeds.length).to.be.above(0);",
              "});",
              " ",
              "// Kiểm tra nếu có giống \"American Bobtail\" và \"Arabian Mau\"",
              "const americanBobtail = breeds.find(b => b.name === \"American Bobtail\");",
              "const arabianMau = breeds.find(b => b.name === \"Arabian Mau\");",
              " ",
              "pm.test(\"American Bobtail breed is present\", function () {",
              "    pm.expect(americanBobtail).to.exist;",
              "});",
              " ",
              "pm.test(\"Arabian Mau breed is present\", function () {",
              "    pm.expect(arabianMau).to.exist;",
              "});",
              " ",
              "// Lưu id của hai giống vào biến môi trường",
              "if (americanBobtail) {",
              "    pm.environment.set(\"americanBobtailId\", americanBobtail.id);",
              "}",
              "if (arabianMau) {",
              "    pm.environment.set(\"arabianMauId\", arabianMau.id);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
