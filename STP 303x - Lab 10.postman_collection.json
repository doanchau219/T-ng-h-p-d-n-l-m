              "if (pm.response.code === 200) {",
              "    //extract response ra JSON",
              "    const resultJson = pm.response.json();",
              "    ",
              "    pm.test(\"TC2: Call API get thành công với status success\", function () {",
              "        pm.expect(resultJson.status).to.eql(\"success\");",
              "    });",
              "    pm.test(\"TC3: Call API get thành công, tồn tại giống chó husky\", function () {",
              "        pm.expect(resultJson.message.husky).to.not.null;",
