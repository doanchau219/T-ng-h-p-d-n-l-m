    {
      "name": "lấy về các giống mèo, lưu lại id ",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Kiểm tra nếu response trả về HTTP 200 OK",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              " ",
              "// Parse response JSON",
              "const catImages = pm.response.json();",
              " ",
              "// Kiểm tra nếu mảng ảnh không rỗng",
              "pm.test(\"Cat images array is not empty\", function () {",
              "    pm.expect(catImages.length).to.be.above(0);",
              "});",
              " ",
              "// Kiểm tra nếu ảnh có đủ các trường id và url",
              "pm.test(\"Each image has id and url\", function () {",
              "    catImages.forEach((image) => {",
              "        pm.expect(image.id).to.exist;",
              "        pm.expect(image.name).to.exist;",
              "        pm.expect(image.temperament).to.exist;",
              "        pm.expect(image.origin).to.exist;",
              "        pm.expect(image.description).to.exist;",
              "//      pm.expect(image.wikipedia_url).to.exist; lỗi",
              "",
              "    });",
              "});",
              " ",
              "// Lưu lại id và url của ảnh đầu tiên vào biến môi trường",
              "if (catImages.length > 0) {",
              "    pm.environment.set(\"catImageId\", catImages[0].id);",
              "    pm.environment.set(\"catImageUrl\", catImages[0].url);",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
