          "listen": "test",
          "script": {
            "exec": [
              "// Kiểm tra nếu response trả về HTTP 200 OK",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              " ",
              "// Parse response JSON",
              "const votes = pm.response.json();",
              " ",
              "// Kiểm tra nếu các vote có đủ thông tin về image_id và sub_id",
              "pm.test(\"Each vote has image_id and sub_id\", function () {",
              "    pm.expect(votes.image_id).to.exist;",
              "    pm.expect(votes.sub_id).to.exist;",
              "});",
